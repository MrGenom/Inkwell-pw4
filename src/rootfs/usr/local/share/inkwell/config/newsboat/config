# newsboat on e-ink. Feeds load when you press R (or r for one feed), not on
# start or on a timer, and the colours become black and white with bold for
# unread items. Feeds go in "urls" next to this file.
auto-reload no
reload-threads 3
browser "w3m %u"
confirm-exit no
show-read-feeds yes
text-width 72

color background         default default
color listnormal         default default
color listnormal_unread  default default bold
color listfocus          default default reverse
color listfocus_unread   default default reverse bold
color info               default default reverse
color article            default default
